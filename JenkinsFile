pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'staging', 'prod'],
            description: 'Select environment to run tests'
        )

        choice(
            name: 'BROWSER',
            choices: ['chromium', 'firefox', 'webkit'],
            description: 'Select browser'
        )

        choice(
            name: 'TEST_SUITE',
            choices: ['all', 'smoke', 'regression', 'sanity', 'master', 'datadriven'],
            description: 'Select test suite'
        )
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                bat 'npx playwright install'
            }
        }

        stage('Run Playwright Tests') {
            steps {
                script {

                    def testCommand = ''

                    if (params.TEST_SUITE == 'all') {
                        testCommand = 'npx playwright test'
                    }
                    else if (params.TEST_SUITE == 'sanity') {
                        testCommand = 'npx playwright test --grep @sanity'
                    }
                    else if (params.TEST_SUITE == 'regression') {
                        testCommand = 'npx playwright test'
                    }
                    else if (params.TEST_SUITE == 'datadriven') {
                        testCommand = 'npx playwright test --grep @datadriven'
                    }

                    withEnv([
                        "ENV=${params.ENVIRONMENT}",
                        "BROWSER=${params.BROWSER}"
                    ]) {
                        bat testCommand
                    }
                }
            }
        }

        stage('Generate Allure Report') {
            steps {
                bat '''
                    if exist allure-results (
                        npx allure generate allure-results --clean -o allure-report
                    )
                '''
            }
        }
    }

    post {
        always {
            script {

                if (fileExists('playwright-report')) {
                    publishHTML(target: [
                        reportName: 'Playwright HTML Report',
                        reportDir: 'playwright-report',
                        reportFiles: 'index.html',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])
                }

                if (fileExists('allure-report')) {
                    publishHTML(target: [
                        reportName: 'Allure Report',
                        reportDir: 'allure-report',
                        reportFiles: 'index.html',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])
                }

                archiveArtifacts(
                    artifacts: 'test-results/**/*',
                    allowEmptyArchive: true
                )
            }
        }
    }
}