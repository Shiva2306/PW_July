
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'staging', 'prod'],
            description: 'Select environment to run tests'
        )

        choice(
            name: 'BROWSER',
            choices: ['chromium', 'firefox', 'webkit'],
            description: 'Select browser'
        )

        choice(
            name: 'TEST_SUITE',
            choices: ['all', 'smoke', 'regression', 'api-smoke'],
            description: 'Select test suite'
        )
    }

    environment {
        DOCKER_IMAGE = 'pw-framework'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Playwright Tests') {
            steps {
                script {

                    def testCommand = ''

                    if (params.TEST_SUITE == 'all') {
                        testCommand = 'npx playwright test'
                    }
                    else if (params.TEST_SUITE == 'smoke') {
                        testCommand = 'npx playwright test --grep @smoke'
                    }
                    else if (params.TEST_SUITE == 'regression') {
                        testCommand = 'npx playwright test'
                    }
                    else if (params.TEST_SUITE == 'api-smoke') {
                        testCommand = 'npx playwright test --grep @api-smoke'
                    }

                    sh 'mkdir -p reports allure-results'

                    sh """
                        docker run --rm \
                            -e CI=true \
                            -e ENV=${params.ENVIRONMENT} \
                            -e BROWSER=${params.BROWSER} \
                            -v \${WORKSPACE}/reports:/app/playwright-report \
                            -v \${WORKSPACE}/allure-results:/app/allure-results \
                            ${DOCKER_IMAGE} \
                            ${testCommand}
                    """
                }
            }
        }

        stage('Generate Allure Report') {
            steps {
                sh '''
                    mkdir -p allure-report
                    npx allure generate allure-results \
                        --clean \
                        -o allure-report || true
                '''
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                reportName: 'Playwright HTML Report',
                reportDir: 'reports',
                reportFiles: 'index.html',
                keepAll: true,
                alwaysLinkToLastBuild: true
            ])

            publishHTML(target: [
                reportName: 'Allure Report',
                reportDir: 'allure-report',
                reportFiles: 'index.html',
                keepAll: true,
                alwaysLinkToLastBuild: true
            ])

            archiveArtifacts artifacts: 'test-results/**/*',
                allowEmptyArchive: true
        }
    }
}